+        option: libc::c_int,
+    ) -> io::Result<()> {
+        let request = libc::ipv6_mreq {
+            ipv6mr_multiaddr: libc::in6_addr {
+                s6_addr: addr.octets(),
+            },
+            ipv6mr_interface: interface,
+        };
+        unsafe { setsockopt(self.socket.as_raw_fd(), libc::IPPROTO_IPV6, option, request) }
     }

