new file mode 100644
--- /dev/null
+++ b/tests/loopback.rs
@@ -0,0 +1,75 @@
+// SPDX-FileCopyrightText: 2026 Contributors to the Eclipse Foundation
+// SPDX-License-Identifier: MIT
+
+use socket2::Domain;
+use socket_pktinfo::PktInfoUdpSocket;
+use std::convert::TryFrom;
+use std::io;
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr, UdpSocket};
+use std::time::Duration;
+
+fn loopback_packet(domain: Domain, address: IpAddr) -> io::Result<u32> {
+    let receiver = PktInfoUdpSocket::new(domain)?;
+    receiver.bind(&SocketAddr::new(address, 0).into())?;
+    let cloned = receiver.try_clone_std()?;
+    cloned.set_read_timeout(Some(Duration::from_secs(2)))?;
+    let destination = cloned.local_addr()?;
+    drop(cloned);
+
+    let sender = UdpSocket::bind(SocketAddr::new(address, 0))?;
+    let payload = b"packet info loopback";
+    sender.send_to(payload, destination)?;
+
+    let mut buffer = [0; 64];
+    let (length, info) = receiver.recv(&mut buffer)?;
+    assert_eq!(&buffer[..length], payload);
+    assert_eq!(info.addr_dst, address);
+    assert_eq!(info.addr_src, sender.local_addr()?);
+    assert!(info.if_index > 0);
+    Ok(u32::try_from(info.if_index).expect("interface index fits u32"))
+}
+
+#[test]
+fn ipv4_loopback_destination_and_interface() -> io::Result<()> {
+    loopback_packet(Domain::IPV4, Ipv4Addr::LOCALHOST.into())?;
+    Ok(())
+}
+
+#[test]
+fn ipv4_multicast_destination_and_interface() -> io::Result<()> {
+    let interface = loopback_packet(Domain::IPV4, Ipv4Addr::LOCALHOST.into())?;
+    let group = Ipv4Addr::new(239, 255, 0, 114);
+    let receiver = PktInfoUdpSocket::new(Domain::IPV4)?;
+    receiver.bind(&SocketAddr::new(Ipv4Addr::UNSPECIFIED.into(), 0).into())?;
+    let cloned = receiver.try_clone_std()?;
+    cloned.set_read_timeout(Some(Duration::from_secs(2)))?;
+    let port = cloned.local_addr()?.port();
+    receiver.join_multicast_v4(&group, &Ipv4Addr::LOCALHOST)?;
+
+    let sender = PktInfoUdpSocket::new(Domain::IPV4)?;
+    sender.set_multicast_if_v4(&Ipv4Addr::LOCALHOST)?;
+    sender.set_multicast_loop_v4(true)?;
+    let payload = b"multicast packet info";
+    sender.send_to(payload, &SocketAddr::new(group.into(), port).into())?;
+    let mut buffer = [0; 64];
+    let (length, info) = receiver.recv(&mut buffer)?;
+    assert_eq!(&buffer[..length], payload);
+    assert_eq!(info.addr_dst, IpAddr::V4(group));
+    assert_eq!(info.if_index, u64::from(interface));
+    assert_eq!(info.addr_src.ip(), IpAddr::V4(Ipv4Addr::LOCALHOST));
+    receiver.leave_multicast_v4(&group, &Ipv4Addr::LOCALHOST)?;
+    Ok(())
+}
+
+#[test]
+fn ipv6_loopback_destination_interface_and_membership() -> io::Result<()> {
+    let interface = loopback_packet(Domain::IPV6, Ipv6Addr::LOCALHOST.into())?;
+    let socket = PktInfoUdpSocket::new(Domain::IPV6)?;
+    let group: Ipv6Addr = "ff02::114".parse().unwrap();
+    socket.join_multicast_v6(&group, interface)?;
+    socket.leave_multicast_v6(&group, interface)?;
+    assert!(socket.join_multicast_v6(&group, u32::MAX).is_err());
+    // A failed membership request must not consume or close the socket.
+    socket.bind(&SocketAddr::new(Ipv6Addr::LOCALHOST.into(), 0).into())?;
+    Ok(())
+}
