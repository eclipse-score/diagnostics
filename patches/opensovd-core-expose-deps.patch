+/// Runs the embedded gateway with supplied auth until `shutdown` resolves.
+pub async fn run_with_auth_and_shutdown(
+    cli: cli::Cli,
+    topology: Topology,
+    auth: Auth,
+    shutdown: impl Future<Output = ()> + Send + 'static,
+) -> anyhow::Result<()> {
+    #[cfg(feature = "mock")]
+    anyhow::ensure!(!cli.mock, "--mock cannot be used with a supplied topology");
+    anyhow::ensure!(
+        cli.auth.jwks.is_none(),
+        "supplied auth cannot be combined with --auth-jwks"
+    );
+    serve(cli, Some(auth), topology, shutdown).await
+}
