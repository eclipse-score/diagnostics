+     /// mapped pages, i.e. borrowing the mapping when the pages
+     /// are freed results in undefined behaviour.
+-    DontNeed = libc::MADV_DONTNEED,
++    ///
++    /// On QNX, this operation returns [`std::io::ErrorKind::Unsupported`].
++    /// `POSIX_MADV_DONTNEED` is only an access hint, not a destructive discard.
++    DontNeed = MADV_DONTNEED,
+
+     //
+     // The rest are Linux-specific
+diff --git a/src/unix.rs b/src/unix.rs
