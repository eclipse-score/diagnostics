+# SPDX-FileCopyrightText: 2026 Copyright (c) Contributors to the Eclipse Foundation
+# SPDX-License-Identifier: Apache-2.0
+#
+# memmap2 0.9.11 and 0.9.12: QNX POSIX access-pattern advice.
+# QNX API: https://www.qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.lib_ref/topic/p/posix_madvise.html
+# DontNeed is explicitly unsupported; POSIX_DONTNEED is not a destructive discard.
+diff --git a/Cargo.toml b/Cargo.toml
+index bebfe50..b0b6454 100644
+--- a/Cargo.toml
++++ b/Cargo.toml
+@@ -58,2 +58,5 @@
+ [target."cfg(unix)".dependencies.libc]
