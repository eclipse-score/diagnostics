+mod tests {
+    use super::*;
+
+    #[test]
+    fn posix_advice_hints() {
+        let mmap = MmapInner::map_anon(page_size(), false, false, None, false).unwrap();
+        for advice in [
+            libc::POSIX_MADV_NORMAL,
+            libc::POSIX_MADV_RANDOM,
+            libc::POSIX_MADV_SEQUENTIAL,
+            libc::POSIX_MADV_WILLNEED,
+        ] {
+            mmap.advise_posix(advice, 0, mmap.len()).unwrap();
+            mmap.advise_posix(advice, 1, mmap.len() - 1).unwrap();
+            mmap.advise_posix(advice, 0, 0).unwrap();
+            mmap.advise_posix(advice, mmap.len(), 0).unwrap();
+        }
+    }
+
+    fn check_later_page_ranges(mmap: &MmapInner) {
+        let page = page_size();
+        for (offset, len) in [
+            (page + 1, 1),
+            (page - 1, 2),
+            (page + 1, mmap.len() - page - 1),
+            (mmap.len() - 1, 1),
+        ] {
+            mmap.advise_posix(libc::POSIX_MADV_RANDOM, offset, len)
+                .unwrap();
+        }
+    }
+
+    #[test]
+    fn posix_advice_later_page_ranges() {
+        let mmap = MmapInner::map_anon(3 * page_size(), false, false, None, false).unwrap();
+        check_later_page_ranges(&mmap);
+    }
+
+    #[test]
+    fn posix_advice_file_offset_ranges() {
+        let file = tempfile::tempfile().unwrap();
+        file.set_len((3 * page_size()) as u64).unwrap();
+        // SAFETY: The temporary file is not modified while its mapping exists.
+        let mmap = unsafe {
+            crate::MmapOptions::new()
+                .offset(1)
+                .len(3 * page_size() - 1)
+                .map(&file)
+                .unwrap()
+        };
+        assert_eq!(mmap.as_ptr() as usize % page_size(), 1);
+        check_later_page_ranges(&mmap.inner);
+    }
+
+    #[test]
+    fn posix_advice_errors() {
+        let mmap = MmapInner::map_anon(page_size(), false, false, None, false).unwrap();
+        for (offset, len) in [
+            (0, mmap.len()),
+            (0, 0),
+            (mmap.len(), 0),
+            (mmap.len() + 1, 0),
+        ] {
+            assert_eq!(
+                mmap.advise_posix(libc::POSIX_MADV_DONTNEED, offset, len)
+                    .unwrap_err()
+                    .kind(),
+                io::ErrorKind::Unsupported
+            );
+        }
+        for (offset, len) in [
+            (mmap.len() + 1, 0),
+            (mmap.len(), 1),
+            (1, mmap.len()),
+            (usize::MAX, 0),
+            (usize::MAX, 1),
+            (1, usize::MAX),
+        ] {
+            assert_eq!(
+                mmap.advise_posix(libc::POSIX_MADV_RANDOM, offset, len)
+                    .unwrap_err()
+                    .raw_os_error(),
+                Some(libc::EINVAL)
+            );
+        }
+
+        // Leave a different errno behind to detect accidental last_os_error() handling.
+        assert_eq!(unsafe { libc::close(-1) }, -1);
+        assert_eq!(
+            posix_madvise_result(libc::EINVAL)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EINVAL)
+        );
+        posix_madvise_result(0).unwrap();
+
+        let empty = MmapInner::map_anon(0, false, false, None, false).unwrap();
+        empty.advise_posix(libc::POSIX_MADV_RANDOM, 0, 0).unwrap();
+    }
