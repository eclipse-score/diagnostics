+    #[cfg(any(
+        target_os = "nto",
+        target_os = "qnx",
+        all(test, any(target_os = "linux", target_os = "macos"))
+    ))]
+    fn advise_posix(&self, advice: libc::c_int, offset: usize, len: usize) -> io::Result<()> {
+        // POSIX DONTNEED does not implement UncheckedAdvice::DontNeed's discard semantics.
+        if advice == libc::POSIX_MADV_DONTNEED {
+            return Err(io::ErrorKind::Unsupported.into());
+        }
+        if offset > self.len || len > self.len - offset {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        if len == 0 {
+            return Ok(());
+        }
+        let ptr = self.ptr.wrapping_add(offset);
+        let alignment = ptr as usize % page_size();
+        let ptr = ptr.wrapping_sub(alignment);
+        let len = len
+            .checked_add(alignment)
+            .ok_or_else(|| io::Error::from(io::ErrorKind::InvalidInput))?;
+
+        // SAFETY: The range is within the mapping, rounded down to its containing page.
+        let result = unsafe { libc::posix_madvise(ptr, len, advice) };
+        posix_madvise_result(result)
+    }
+
+    #[cfg(any(target_os = "nto", target_os = "qnx"))]
+    pub unsafe fn advise(&self, advice: libc::c_int, offset: usize, len: usize) -> io::Result<()> {
+        self.advise_posix(advice, offset, len)
+    }
+
