+#[cfg(any(
+    target_os = "nto",
+    target_os = "qnx",
+    all(test, any(target_os = "linux", target_os = "macos"))
+))]
+fn posix_madvise_result(result: libc::c_int) -> io::Result<()> {
+    if result == 0 {
+        Ok(())
+    } else {
+        // Unlike madvise, posix_madvise returns the error number directly.
+        Err(io::Error::from_raw_os_error(result))
+    }
+}
